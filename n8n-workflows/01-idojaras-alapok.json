{
  "name": "01 - Időjárás (alapok)",
  "nodes": [
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Kézi indítás",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-220, 0]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Minden reggel 7-kor",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-220, 200]
    },
    {
      "parameters": {
        "url": "https://api.open-meteo.com/v1/forecast",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "latitude", "value": "47.4979" },
            { "name": "longitude", "value": "19.0402" },
            { "name": "current", "value": "temperature_2m,weather_code" },
            { "name": "daily", "value": "temperature_2m_max,temperature_2m_min,precipitation_probability_max" },
            { "name": "timezone", "value": "Europe/Budapest" },
            { "name": "forecast_days", "value": "1" }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Időjárás lekérése",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 100]
    },
    {
      "parameters": {
        "jsCode": "// Az n8n minden node-ban ITEM-EKKEL dolgozik (egy tömb).\n// Itt most egyetlen item jön be az API-tól.\nconst adat = $input.first().json;\n\nconst kodok = {\n  0: 'derült', 1: 'nagyrészt derült', 2: 'részben felhős', 3: 'borult',\n  45: 'ködös', 48: 'zúzmarás köd',\n  51: 'gyenge szitálás', 53: 'szitálás', 55: 'erős szitálás',\n  61: 'gyenge eső', 63: 'eső', 65: 'erős eső',\n  71: 'gyenge havazás', 73: 'havazás', 75: 'erős havazás',\n  80: 'záporok', 81: 'záporok', 82: 'heves záporok',\n  95: 'zivatar', 96: 'zivatar jégesővel', 99: 'heves zivatar'\n};\n\nconst most = adat.current.temperature_2m;\nconst max = adat.daily.temperature_2m_max[0];\nconst min = adat.daily.temperature_2m_min[0];\nconst esely = adat.daily.precipitation_probability_max[0];\nconst leiras = kodok[adat.current.weather_code] ?? 'ismeretlen';\n\nconst mondat = `Budapest: most ${most}°C, ${leiras}. Ma ${min}–${max}°C, csapadék esélye ${esely}%.`;\n\n// Amit visszaadsz, az lesz a következő node bemenete.\nreturn [{ json: { mondat, most, min, max, esely, leiras } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Mondattá alakítás",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.esely }}",
              "rightValue": 40,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Esni fog?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [520, 100]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-1",
              "name": "uzenet",
              "value": "={{ $json.mondat }} ☔ Vigyél esernyőt!",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Esernyő kell",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [760, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-2",
              "name": "uzenet",
              "value": "={{ $json.mondat }} 🙂 Esernyő nem kell.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Esernyő nem kell",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [760, 200]
    }
  ],
  "connections": {
