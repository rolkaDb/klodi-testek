    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Aktuális időjárás és mai előrejelzés lekérése bármely helyszínre a világon. A helyszín földrajzi koordinátáit tizedes fokban kell megadnod (példa: Budapest = latitude 47.4979, longitude 19.0402). A válasz Celsiusban és km/h-ban érkezik.",
        "url": "https://api.open-meteo.com/v1/forecast",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "latitude",
              "value": "={{ $fromAI('latitude', 'A helyszín földrajzi szélessége tizedes fokban, például Budapest esetén 47.4979', 'number') }}"
            },
            {
              "name": "longitude",
              "value": "={{ $fromAI('longitude', 'A helyszín földrajzi hosszúsága tizedes fokban, például Budapest esetén 19.0402', 'number') }}"
            },
            {
              "name": "current",
              "value": "temperature_2m,weather_code,wind_speed_10m"
            },
            {
              "name": "daily",
              "value": "temperature_2m_max,temperature_2m_min,precipitation_probability_max"
            },
            {
              "name": "timezone",
              "value": "auto"
            },
            {
              "name": "forecast_days",
              "value": "1"
            }
          ]
        },
        "options": {}
      },
